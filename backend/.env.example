# ---- Server ----
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000

# ---- Database ----
MONGO_URI=mongodb://localhost:27017/alquds_pharmacy

# ---- Auth ----
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d
COOKIE_SECRET=replace_with_a_long_random_secret

# ---- Cloud file storage (prescriptions, product images, avatars) ----
# Do NOT store prescription files in MongoDB or in a public folder.
CLOUD_STORAGE_PROVIDER=cloudinary
CLOUD_STORAGE_KEY=
CLOUD_STORAGE_SECRET=
CLOUD_STORAGE_BUCKET=

# ---- Payment (provider-independent — see services/payment) ----
PAYMENT_PROVIDER=cod
PAYMENT_PUBLIC_KEY=
PAYMENT_SECRET_KEY=

# ---- Email/notifications ----
EMAIL_PROVIDER=
EMAIL_FROM=no-reply@alquds-pharmacy.example
